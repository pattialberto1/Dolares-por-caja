# Clave de la API de Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo que lee los billetes. Ver la tabla de costos en el README.
#   claude-opus-5    → el más preciso leyendo seriales (por defecto)
#   claude-sonnet-5  → intermedio
#   claude-haiku-4-5 → el más barato
MODELO_CLAUDE=claude-opus-5

# Puerto del servidor
PUERTO=3000

# PIN del usuario "admin" que se crea la primera vez que arranca
PIN_ADMIN=1234

# Tamaño al que se encoge la foto antes de mandarla a Claude.
# Más grande lee mejor, pero cuesta más. Entre 1200 y 2000.
MAX_LADO_PX=1800

# Carpeta donde se guardan la base de datos y las fotos
DIR_DATOS=./datos

# Pon 1 si sirves la app por HTTPS (recomendado en producción)
COOKIE_SEGURA=0

# Pon 1 para probar la app sin llamar a la API (inventa seriales, no gasta)
SIMULAR_LECTURA=0
