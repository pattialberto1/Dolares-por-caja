# ── Base de datos (Supabase) ────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string.
# Usa el modo "Transaction" (puerto 6543): es el que aguanta serverless.
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Almacenamiento de fotos (Supabase Storage) ─────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Nombre del bucket privado donde van las fotos
BUCKET_FOTOS=billetes

# ── Claude ─────────────────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5 (preciso) · claude-sonnet-5 · claude-haiku-4-5 (barato)
MODELO_CLAUDE=claude-opus-5

# ── Ajustes ────────────────────────────────────────────────────────────────
# PIN del usuario "admin" que se crea la primera vez
PIN_ADMIN=1234
# Puerto en desarrollo local
PUERTO=3000
# Pon 0 solo en local sin HTTPS; en Vercel déjalo sin tocar
COOKIE_SEGURA=0

# ── Para probar sin gastar ─────────────────────────────────────────────────
# 1 = inventa los seriales en vez de llamar a Claude
SIMULAR_LECTURA=0
# 1 = guarda las fotos en memoria en vez de en Supabase (solo pruebas)
SIMULAR_ALMACEN=0
